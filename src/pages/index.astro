---
import '../styles/fonts.css';
import '../styles/theme.css';
import { experience, profile, projects } from '../data/profile';
import ProjectObject from '../components/ProjectObject.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Alex Gavalas — Senior Software Engineer in Leipzig. Selected projects and experience." />
    <title>Alex Gavalas — Senior Software Engineer</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="site-header">
        <span class="personal-mark" aria-label="Alex Gavalas">ag<span>.</span></span>
        <nav aria-label="Main navigation"><a href="#work">Projects</a><a href="#experience">Experience</a><a class="header-contact" href={`mailto:${profile.email}`}>Let’s talk <span aria-hidden="true">↗</span></a></nav>
      </header>

      <main id="main">
        <section class="introduction" aria-labelledby="name">
          <div class="identity">
            <h1 id="name">Alex Gavalas</h1>
            <p class="role">Senior Software Engineer</p>
            <a class="cv-link" href="/alex-gavalas-cv.pdf" download="alex-gavalas-cv.pdf"><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M10 3v9m-3-3 3 3 3-3M4 13v3a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-3" /></svg>Download CV <span>PDF · 76 KB</span></a>
            <nav class="social-links" aria-label="Social links">{profile.socials.map((social) => <a href={social.href}>{social.label} <span aria-hidden="true">↗</span></a>)}</nav>
          </div>
          <div class="intro-copy">
            <p class="intro-lead">Complex interfaces, made simple.<br /><span>Always curious to learn.</span></p>
            <p>I lead product development from ideation to implementation, with a focus on software architecture, developer experience, and maintainable systems.</p>
            <div class="contact-actions">
              <a class="contact-button pressable" href={`mailto:${profile.email}`}><svg aria-hidden="true" viewBox="0 0 20 20"><rect x="2.5" y="4.5" width="15" height="11" rx="2" /><path d="m3 6 7 5 7-5" /></svg>Email me</a>
              <button class="copy-button pressable" type="button" hidden data-email={profile.email}><svg aria-hidden="true" viewBox="0 0 20 20"><rect x="6.5" y="6.5" width="10" height="10" rx="2" /><path d="M13 6V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2" /></svg><span>Copy email</span></button>
              <span class="sr-only" role="status" id="copy-status"></span>
            </div>
          </div>
        </section>

        <section id="work" class="work-section" aria-labelledby="work-title">
          <div class="section-heading"><h2 id="work-title">A couple of things I’m building</h2></div>
          <div class="workbench">
            <div class="bench-toolbar">
              <span class="bench-label"><span aria-hidden="true">⊞</span> Personal projects</span>
              <div class="project-tabs" role="tablist" aria-label="Choose a project" hidden>
                <span class="tab-indicator" aria-hidden="true"></span>
                {projects.map((project, i) => <button type="button" role="tab" id={`tab-${project.id}`} aria-controls={`panel-${project.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{project.name}</button>)}
              </div>
            </div>
            <div class="bench-content">
              <ProjectObject compact id="workbench-object" />
              <div class="project-panels">
                {projects.map((project, i) => (
                  <article class="project-panel project-details" id={`panel-${project.id}`} aria-labelledby={`project-title-${project.id}`}>
                  <div class:list={['project-icon', { 'notes-icon': i === 1 }]} aria-hidden="true">{i === 0 ? 'h.' : 'lp.'}</div>
                  <p class="project-category">{i === 0 ? 'A little more everyday balance' : 'An ongoing curiosity'}</p>
                  <h3 id={`project-title-${project.id}`}>{project.name}</h3>
                  <p class="project-description">{i === 0 ? 'Meal planning, movement, and progress, connected. A practical home for the habits that make up everyday life.' : 'My collection of notes, useful resources, and interesting detours. A place to keep learning, and find things again.'}</p>
                  <div class="project-topics">{(i === 0 ? ['Next.js', 'TypeScript', 'PostgreSQL'] : ['Notes', 'Resources', 'Web development']).map((topic) => <span>{topic}</span>)}</div>
                  <div class="project-links"><a class="visit-link pressable" href={project.href}>Visit project <span aria-hidden="true">↗</span></a><a href={project.source} class="source-link pressable">Source code <span aria-hidden="true">↗</span></a></div>
                  </article>
                ))}
              </div>
            </div>
            <ProjectPreview projects={projects} />
          </div>
        </section>

        <section id="experience" class="experience-section" aria-labelledby="experience-title">
          <div class="section-heading"><h2 id="experience-title">Along the way</h2><span>Experience</span></div>
          <div class="experience-list">{experience.map((job, i) => <a class="experience-row" href={job.href}><span class:list={['job-icon', `job-icon-${i}`]} aria-hidden="true">{i === 0 ? 'w.' : i === 1 ? 'dt' : 'aa'}</span><div><h3>{job.company}</h3><p>{job.roles[0].title}</p></div><span class="job-period">{job.period}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div>
        </section>
      </main>
      <footer><p>Built with care. Based in {profile.location}.</p></footer>
    </div>
    <script>
      const tabList = document.querySelector<HTMLElement>('.project-tabs');
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('.project-panel'));
      const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-project-preview]'));
      const indicator = document.querySelector<HTMLElement>('.tab-indicator');
      const exhibit = document.querySelector<HTMLElement>('[data-project-exhibit]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let panelAnimation: Animation | undefined;

      function selectProject(index: number, animate: boolean, rotateObject = true) {
        panelAnimation?.cancel();
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
          panels[i].hidden = i !== index;
          if (previews[i]) previews[i].hidden = i !== index;
        });
        if (indicator) {
          indicator.style.transitionDuration = animate && !reducedMotion.matches ? '180ms' : '0ms';
          indicator.style.transform = `translateX(${index * 100}%)`;
        }
        if (animate && !reducedMotion.matches) {
          panelAnimation = panels[index].animate(
            [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 180, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
          );
        }
        if (rotateObject) exhibit?.dispatchEvent(new CustomEvent('project-object:select', { detail: { index, animate } }));
      }

      if (tabList && tabs.length === panels.length && panels.length > 0) {
        panels.forEach((panel, i) => {
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', tabs[i].id);
          panel.tabIndex = 0;
        });
        selectProject(0, false);
        tabList.hidden = false;
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', (event) => selectProject(i, event.detail > 0));
          tab.addEventListener('keydown', (event) => {
            let next: number;
            if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
            else if (event.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = tabs.length - 1;
            else return;
            event.preventDefault();
            selectProject(next, false);
            tabs[next].focus();
          });
        });
        exhibit?.addEventListener('project-object:change', (event) => {
          const { index } = (event as CustomEvent<{ index: number }>).detail;
          if (index !== 0 && index !== 1) return;
          if (tabs[index].getAttribute('aria-selected') !== 'true') selectProject(index, false, false);
        });
      }

      const copyButton = document.querySelector<HTMLButtonElement>('.copy-button');
      const copyStatus = document.querySelector('#copy-status');
      if (copyButton && navigator.clipboard && window.isSecureContext) {
        copyButton.hidden = false;
        let resetTimer: ReturnType<typeof setTimeout>;
        copyButton.addEventListener('click', async () => {
          const label = copyButton.querySelector('span');
          if (!label || !copyButton.dataset.email) return;
          clearTimeout(resetTimer);
          try {
            await navigator.clipboard.writeText(copyButton.dataset.email);
            label.textContent = 'Copied!';
            if (copyStatus) copyStatus.textContent = 'Email address copied to clipboard.';
          } catch {
            label.textContent = 'Try email';
            if (copyStatus) copyStatus.textContent = 'Could not copy. Use the Email me link instead.';
          }
          resetTimer = setTimeout(() => {
            label.textContent = 'Copy email';
            if (copyStatus) copyStatus.textContent = '';
          }, 2200);
        });
      }
    </script>
  </body>
</html>

<style>
  :global(body) { margin: 0; background: var(--page); color: var(--ink); font-family: 'Source Sans 3 Variable', sans-serif; font-weight: 400; -webkit-font-smoothing: antialiased; }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-padding-top: 28px; }
  :global(::selection) { background: var(--citron); color: var(--ink); }
  a { text-decoration: none; color: inherit; }
  button { color: inherit; font: inherit; cursor: pointer; }
  button[hidden], [hidden] { display: none !important; }
  a:focus-visible, button:focus-visible, [role='tabpanel']:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  h1, h2, h3, h4, p { margin: 0; }
  svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .page { max-width: 1080px; margin: auto; padding: 0 36px; }
  .site-header { padding: 29px 0; display: flex; align-items: center; justify-content: space-between; }
  .personal-mark { font-size: 24px; line-height: 1; letter-spacing: -1.8px; font-weight: 600; }
  .personal-mark span { color: var(--accent); }
  .site-header nav { display: flex; align-items: center; gap: 28px; font-size: 12px; color: var(--muted); }
  .header-contact { color: var(--ink); border: 1px solid var(--border); border-radius: 7px; padding: 8px 12px; background: var(--surface); box-shadow: 0 1px 2px #243e3605; }
  .header-contact > span { padding-left: 8px; }
  .introduction { display: grid; grid-template-columns: 1fr 1.15fr; gap: 80px; padding: 43px 0 53px; }
  h1 { font-size: 43px; letter-spacing: -2px; font-weight: 500; line-height: 1.12; margin-bottom: 9px; }
  .role { color: var(--muted); font-size: 16px; }
  .cv-link { display: inline-flex; gap: 8px; align-items: center; margin-top: 19px; min-height: 42px; padding: 9px 13px; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); font-size: 12px; font-weight: 500; color: var(--accent); box-shadow: 0 1px 2px #243e3605; }
  .cv-link > span { margin-left: 3px; font-size: 10px; font-weight: 400; color: var(--muted); }
  .intro-lead { font-size: 25px; line-height: 1.4; letter-spacing: -.8px; font-weight: 500; margin-bottom: 17px; }
  .intro-lead > span { color: var(--muted); }
  .intro-copy > p:not(.intro-lead) { font-size: 13px; line-height: 1.8; color: var(--muted); max-width: 390px; }
  .contact-actions { margin-top: 21px; display: flex; gap: 10px; align-items: center; }
  .contact-button, .copy-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 13px; font-size: 11px; border-radius: 7px; height: 36px; }
  .contact-button { background: var(--ink); color: var(--surface); border: 1px solid var(--ink); box-shadow: inset 0 1px #ffffff24, 0 1px 2px #243e3612; }
  .copy-button { background: var(--surface); border: 1px solid var(--border); width: 118px; color: var(--muted); box-shadow: 0 1px 2px #243e3605; }
  .pressable { transition: transform 140ms cubic-bezier(.23, 1, .32, 1); }
  .pressable:active { transform: scale(.97); }
  .pressable:focus-visible { transition: none; }
  .section-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 15px; }
  .section-heading h2 { font-size: 13px; font-weight: 500; letter-spacing: -.15px; }
  .section-heading > span { color: var(--muted); font-size: 10px; }
  .workbench { border: 1px solid var(--border); border-radius: 12px; background: var(--surface); box-shadow: 0 2px 4px #243e3603; overflow: clip; }
  .bench-toolbar { padding: 12px 16px; border-bottom: 1px solid var(--border-soft); display: flex; justify-content: space-between; align-items: center; gap: 15px; background: var(--surface); }
  .bench-label { color: var(--muted); font-size: 10px; display: flex; align-items: center; gap: 7px; }
  .bench-label > span { font-size: 17px; color: var(--muted); }
  .project-tabs { position: relative; display: flex; background: var(--surface-soft); border-radius: 7px; padding: 3px; isolation: isolate; }
  .tab-indicator { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / 2); background: var(--surface); box-shadow: 0 1px 3px #243e361a, 0 0 0 1px #243e3605; border-radius: 5px; z-index: -1; transition: transform 180ms cubic-bezier(.23, 1, .32, 1); }
  .project-tabs button { width: 109px; background: none; border: 0; padding: 7px 10px; font-size: 10px; color: var(--muted); border-radius: 5px; }
  .project-tabs button[aria-selected='true'] { color: var(--ink); }
  .bench-content { display: grid; grid-template-columns: 1.52fr minmax(0, 1fr); }
  .project-panels { min-width: 0; border-left: 1px solid var(--border-soft); }
  .project-panel + .project-panel { border-top: 1px solid var(--border-soft); }
  .project-panel[role='tabpanel'] { min-height: 100%; border-top: 0; }
  .project-details { padding: 31px 30px 26px; display: flex; flex-direction: column; align-items: flex-start; }
  .project-icon { width: 39px; height: 39px; background: var(--citron-soft); border-radius: 10px; border: 1px solid var(--citron); color: var(--ink); font-size: 26px; font-weight: 500; letter-spacing: -3px; display: flex; align-items: center; justify-content: center; padding-right: 3px; box-shadow: 0 1px 2px #243e3605; margin-bottom: 19px; }
  .project-category { font-size: 9px; color: var(--muted); margin-bottom: 6px; }
  .project-details h3 { font-size: 25px; font-weight: 500; letter-spacing: -.9px; }
  .project-description { font-size: 12px; line-height: 1.8; color: var(--muted); margin-top: 12px; }
  .project-topics { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 25px; }
  .project-topics > span { font-size: 8px; border: 1px solid var(--border-soft); border-radius: 4px; padding: 4px 6px; color: var(--muted); }
  .project-links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; width: 100%; margin-top: auto; }
  .visit-link, .source-link { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 42px; padding: 10px 13px; border-radius: 7px; font-size: 12px; font-weight: 500; box-shadow: 0 1px 2px #24292e08; }
  .visit-link { background: var(--ink); color: var(--surface); border: 1px solid var(--ink); }
  .source-link { background: var(--surface); color: var(--accent); border: 1px solid var(--border); }
  .notes-icon { background: var(--rose-soft); color: var(--ink); border-color: var(--rose); font-size: 21px; }
  .experience-section { margin-top: 32px; }
  .experience-list { border-top: 1px solid var(--border-soft); }
  .experience-row { display: grid; grid-template-columns: 33px minmax(0, 1fr) auto 16px; align-items: center; gap: 13px; padding: 13px 0; border-bottom: 1px solid var(--border-soft); }
  .job-icon { width: 31px; height: 31px; display: grid; place-items: center; font-size: 13px; border: 1px solid var(--border); border-radius: 8px; color: var(--accent); background: var(--surface-soft); font-weight: 600; letter-spacing: -.8px; }
  .job-icon-1 { background: var(--citron-soft); border-color: var(--citron); color: var(--ink); font-size: 10px; letter-spacing: 0; }
  .job-icon-2 { background: var(--rose-soft); border-color: var(--rose); color: var(--ink); font-size: 11px; letter-spacing: -.5px; }
  .experience-row h3 { font-size: 11px; font-weight: 500; }
  .experience-row p { font-size: 9px; color: var(--muted); margin-top: 4px; }
  .job-period { font-size: 10px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .row-arrow { font-size: 13px; color: var(--accent); }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 25px 0 32px; }
  footer > p { font-size: 9px; color: var(--muted); }
  .social-links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 14px; font-size: 12px; color: var(--accent); }
  .social-links a { padding: 8px 0; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .social-links span { font-size: 9px; color: var(--accent); padding-left: 3px; }
  .skip-link { position: absolute; top: -100px; padding: 12px; background: var(--ink); color: var(--surface); z-index: 5; }
  .skip-link:focus { top: 10px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (hover: hover) and (pointer: fine) {
    .contact-button:hover { background: var(--accent); }
    .copy-button:hover, .source-link:hover, .cv-link:hover { background: var(--surface-hover); }
    .visit-link:hover { background: var(--accent); }
    .source-link:hover, .social-links a:hover, .cv-link:hover, .site-header nav a:hover { color: var(--ink); }
    .cv-link:hover { text-decoration: underline; text-underline-offset: 4px; }
    .experience-row:hover h3 { text-decoration: underline; text-underline-offset: 3px; }
  }
  @media (max-width: 850px) {
    .introduction { gap: 35px; grid-template-columns: 1fr 1fr; }
    .intro-lead { font-size: 22px; }
    h1 { font-size: 36px; }
    .project-details { padding: 25px 20px; }
    .bench-content { grid-template-columns: 1.1fr minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .page { padding: 0 23px; }
    .site-header { padding: 24px 0; }
    .site-header nav { font-size: 10px; gap: 19px; }
    .header-contact { padding: 7px 9px; }
    .header-contact > span { padding-left: 3px; }
    .introduction { grid-template-columns: minmax(0, 1fr); padding: 28px 0 38px; gap: 30px; }
    h1 { font-size: 39px; }
    .role { font-size: 14px; }
    .cv-link { margin-top: 12px; }
    .intro-lead { font-size: 25px; }
    .intro-copy > p:not(.intro-lead) { font-size: 13px; max-width: none; }
    .section-heading h2 { font-size: 12px; }
    .section-heading > span { font-size: 9px; }
    .bench-toolbar { flex-wrap: wrap; padding: 12px; gap: 12px; }
    .bench-label { width: 100%; }
    .project-tabs { width: 100%; }
    .project-tabs button { flex: 1; width: auto; padding: 8px 10px; font-size: 11px; }
    .bench-content { grid-template-columns: minmax(0, 1fr); }
    .project-panels { border-left: 0; border-top: 1px solid var(--border-soft); }
    .project-details { padding: 25px; }
    .project-icon { margin-bottom: 16px; }
    .project-topics { margin-bottom: 23px; }
    .project-description { font-size: 13px; }
    .job-period { font-size: 9px; }
    .experience-row { gap: 10px; }
    footer { flex-direction: column; align-items: flex-start; gap: 16px; padding-top: 23px; }
  }
  @media (max-width: 350px) {
    .page { padding: 0 18px; }
    .site-header nav { gap: 14px; }
    .section-heading > span { display: none; }
    .experience-row { grid-template-columns: 30px minmax(0, 1fr) auto; gap: 9px; }
    .row-arrow { display: none; }
    .experience-row p { font-size: 8px; }
    .job-period { font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pressable { transition: none; }
    .pressable:active { transform: none; }
    .tab-indicator { transition: none; }
  }
</style>
